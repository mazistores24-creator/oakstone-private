# Copy to .env for local use, or set these in the hosting provider's environment.
# Replace placeholders with your own values. Never commit real credentials.

# Required for production. MongoDB connection string for the portal database.
MONGODB_URI=replace-with-your-mongodb-connection-string
# Optional. Defaults to oakstone_portal when unset.
MONGODB_DB=oakstone_portal
# Required in production. Use a long, private random value.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional first staff account. Set BOTH or neither. Password must be at least
# 12 characters and no more than 72 UTF-8 bytes. Do not leave placeholder values.
# STAFF_EMAIL=admin@example.com
# STAFF_PASSWORD=replace-with-a-strong-password
# STAFF_NAME=Operations user

# Optional. Configure all SMTP settings plus SUPPORT_EMAIL to enable the
# public contact form's email delivery. SMTP_FROM defaults to SMTP_USER.
# SUPPORT_EMAIL=support@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=replace-with-your-smtp-username
# SMTP_PASS=replace-with-your-smtp-password
# SMTP_FROM=support@example.com

# Optional. PORT defaults to 3000. NODE_ENV=production enables secure cookies
# and makes MONGODB_URI and SESSION_SECRET mandatory.
# PORT=3000
# NODE_ENV=production
